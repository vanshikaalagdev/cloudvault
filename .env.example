# ==============================================================================
# CloudVault: Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=supersecret_cloudvault_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Relational Database (PostgreSQL)
# Local host connection (for running outside Docker):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudvault?schema=public
# Docker container connection (for running inside Docker Compose):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cloudvault?schema=public

# Queue & Cache (Redis)
# Local host connection:
REDIS_URL=redis://localhost:6379
# Docker container connection:
# REDIS_URL=redis://redis:6379

# ==============================================================================
# Storage Configuration: Dual-Mode (MinIO vs AWS S3)
# Set STORAGE_PROVIDER to "minio" for zero-cost local dev, or "aws" for production S3
# ==============================================================================
STORAGE_PROVIDER=minio

# S3 Bucket Name
AWS_S3_BUCKET=cloudvault-bucket
AWS_REGION=us-east-1

# --- Mode A: Local MinIO (Default for local development) ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Local host endpoint:
S3_ENDPOINT=http://localhost:9000
# Endpoint accessible by client browser:
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# --- Mode B: Production AWS S3 ---
# Uncomment and supply when deploying to AWS:
# STORAGE_PROVIDER=aws
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=my-production-cloudvault-bucket
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Storage Quota Limits (Per User in bytes, default 50 MB)
USER_STORAGE_QUOTA_BYTES=52428800
